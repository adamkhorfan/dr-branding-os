# DR Branding OS — environment template
# Copy this to .env.local and fill in keys when integrations come online.
# Never commit real keys to git.

# ─── AI Generation (server-side only — no NEXT_PUBLIC_ prefix) ───────────────
# Add ANTHROPIC_API_KEY to enable AI generation in all studios.
ANTHROPIC_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
KLING_API_KEY=

# ─── Supabase (client-safe — NEXT_PUBLIC_ prefix required) ───────────────────
# Add both vars to auto-switch from localStorage to Supabase.
# Run lib/db/supabase-migration.sql in your Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Keep service role key server-side only (do not use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── n8n Automation ──────────────────────────────────────────────────────────
# Used to trigger n8n flows from within the OS (future webhook integration).
N8N_WEBHOOK_BASE_URL=https://your-n8n.com/webhook
N8N_API_KEY=
